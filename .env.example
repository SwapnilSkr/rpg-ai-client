API_BASE_URL=http://localhost:3000
WS_BASE_URL=ws://localhost:3000
GOOGLE_WEB_CLIENT_ID=your-web-client-id.apps.googleusercontent.com

# Android dev (optional): debug/profile remap localhost -> 10.0.2.2 on emulators.
# Physical device + adb reverse: SKIP_ANDROID_LOCALHOST_REMAP=true
# Or use your machine LAN IP: ANDROID_DEV_HOST=192.168.x.x

# Chronicler walkthrough rehearsal (debug builds only).
# true  -> every sign-in wipes the guide record, so logging out and back in
#          with the same number walks you through the whole guide again.
# false -> production behaviour: each surface explains itself once, ever.
# `.env` is a bundled asset, so changing this needs a full restart.
GUIDE_REHEARSAL=false
