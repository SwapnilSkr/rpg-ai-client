<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Night mode outranks the platform-version qualifier, so a dark-mode
         Android 12+ phone would otherwise match values-night and miss the
         splash background set in values-v31. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/everlore_ground</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/everlore_ground</item>
    </style>
</resources>
