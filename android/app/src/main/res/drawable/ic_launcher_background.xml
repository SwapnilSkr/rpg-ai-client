<?xml version="1.0" encoding="utf-8"?>
<!-- The badge's own corners are pure black, so a black plate joins it without
     a seam: the mask can cut wherever it likes and the result still reads as
     one tile. Was the stock Android Studio green grid, which was invisible
     only because the foreground used to cover every pixel of the canvas. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#000000"
        android:pathData="M0,0h108v108h-108z" />
</vector>
